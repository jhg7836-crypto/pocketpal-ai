--- a/scripts/make_icons.py	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/make_icons.py	2026-10-22 10:51:07.649819358 +0000
@@ -0,0 +1,24 @@
+import sys
+from PIL import Image, ImageDraw
+
+SIZES = {"mdpi": 48, "hdpi": 72, "xhdpi": 96, "xxhdpi": 144, "xxxhdpi": 192}
+RES = "android/app/src/main/res"
+
+src = Image.open(sys.argv[1] if len(sys.argv) > 1 else "icon.png").convert("RGBA")
+side = min(src.size)
+left = (src.width - side) // 2
+top = (src.height - side) // 2
+src = src.crop((left, top, left + side, top + side))
+
+for name, size in SIZES.items():
+    img = src.resize((size, size), Image.LANCZOS)
+    img.save(f"{RES}/mipmap-{name}/ic_launcher.png")
+
+    mask = Image.new("L", (size * 4, size * 4), 0)
+    ImageDraw.Draw(mask).ellipse((0, 0, size * 4 - 1, size * 4 - 1), fill=255)
+    mask = mask.resize((size, size), Image.LANCZOS)
+    round_img = img.copy()
+    round_img.putalpha(mask)
+    round_img.save(f"{RES}/mipmap-{name}/ic_launcher_round.png")
+
+print("done")
