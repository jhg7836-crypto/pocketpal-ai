diff -ruN a/src/utils/externalModels.ts b/src/utils/externalModels.ts
--- a/src/utils/externalModels.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/utils/externalModels.ts	2026-10-22 10:50:59.459152961 +0000
@@ -0,0 +1,32 @@
+import {Linking} from 'react-native';
+import * as RNFS from '@dr.pogodin/react-native-fs';
+
+export function treeUriToPath(uri: string): string | null {
+  const decoded = decodeURIComponent(uri).split('/document/')[0];
+  const match = decoded.match(/\/tree\/([^:]+):(.*)$/);
+  if (!match) {
+    return null;
+  }
+  const volume = match[1];
+  const sub = match[2].replace(/\/+$/, '');
+  const root =
+    volume === 'primary' ? '/storage/emulated/0' : `/storage/${volume}`;
+  return sub ? `${root}/${sub}` : root;
+}
+
+export async function listGgufFiles(dir: string): Promise<string[]> {
+  const items = await RNFS.readDir(dir);
+  return items
+    .filter(item => item.isFile() && item.name.toLowerCase().endsWith('.gguf'))
+    .map(item => item.path);
+}
+
+export function openAllFilesAccessSettings() {
+  return Linking.sendIntent(
+    'android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION',
+  );
+}
+
+export function isInsideAppStorage(path: string): boolean {
+  return path.startsWith(RNFS.DocumentDirectoryPath);
+}
